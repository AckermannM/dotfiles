# ---------------------------------------------------------------------------
# Which packages this machine does NOT get.
#
# Everything listed here is excluded from `chezmoi apply`. The flags come from
# ~/.config/chezmoi/chezmoi.toml, generated once by .chezmoi.toml.tmpl.
#
# zsh, starship and nvim carry no flag -- they are on every machine, except
# that Windows takes none of them (see the windows block at the bottom).
#
# Paths for packages still sitting on the archived `main` branch are listed
# ahead of time and are harmless no-ops until their source files exist, so
# migrating one of them is a plain `chezmoi add` with no edit here.
# ---------------------------------------------------------------------------

# Repo documentation, not a dotfile. Matches the target root only, so
# .config/nvim/README.md is unaffected (chezmoi rejects a leading slash here).
README.md

{{ if not .gui }}
.config/kitty
.config/gtk-3.0
.config/spotify-launcher.conf
.config/ghostty
{{ end }}

# Placeholders for when we might get back to Hyprland
{{ if not .wayland }}
.config/hypr
.config/waybar
.config/wofi
{{ end }}

{{ if not .herdr }}
.config/herdr
.config/herdr-automatic-rename
.config/herdr-sessionizer
.local/bin/herdr-sessionizer
{{ end }}

# The PowerShell package is Windows-only: profile plus its own starship config.
{{ if not .windows }}
.config/powershell
{{ end }}

# Windows takes the PowerShell package and herdr's own config.toml, but not the
# herdr plugin packages. The unflagged packages (zsh, nvim, starship) are
# Linux-shaped, and .config/starship.toml in particular is the Catppuccin Mocha
# prompt -- Windows uses the Dracula one at .config/powershell/starship.toml
# instead. Drop a line from here to opt in.
#
# Both herdr plugins are excluded here rather than by the .herdr flag, because
# the flag is now true on Windows too (it gates .config/herdr/config.toml):
#
#   herdr-automatic-rename -- upstream declares platforms = ["linux", "macos"]
#     in its herdr-plugin.toml, and every one of its 20+ event hooks shells out
#     to `bash automatic-rename.sh`. It cannot run here. Shipping its config.sh
#     alone would only look like the plugin was set up. Delete this line if
#     upstream ever adds Windows.
#   herdr-sessionizer -- a bash script, and its keybindings hard-code ~/projects
#     paths that do not exist on this machine. Not wanted on Windows.
#
# .local/bin/herdr-sessionizer needs no line of its own: .local below covers it.
{{ if .windows }}
.config/herdr-automatic-rename
.config/herdr-sessionizer
.config/nvim
.config/starship.toml
.config/zsh
.zshrc
.local
{{ end }}
